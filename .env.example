BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# PostHog analytics (optional). Public project key from eu.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Studio Read (Feature A) — server-only, NEVER expose to the client bundle
GEMINI_API_KEY=
# Carry-over write to the Margot Supabase (anon key + SECURITY DEFINER RPCs).
# Server-only — SUPABASE_URL is a runtime var (NOT NEXT_PUBLIC_, which would be
# inlined at build time and miss values set after the build).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: daily Gemini budget cap for the public endpoint
DAILY_GEMINI_CAP=2000
